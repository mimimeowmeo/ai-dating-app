# Copy to .env and fill in real values:  cp .env.example .env
# Host ports avoid 5432/6379 so this stack can run next to other local projects.
# .env is gitignored. Never commit real secrets (this is a public repo).

# --- PostgreSQL (PostGIS + pgvector) ---
POSTGRES_USER=heartlink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=heartlink
POSTGRES_PORT=5433
DATABASE_URL=postgresql://heartlink:change-me@localhost:5433/heartlink

# --- Redis (BullMQ) ---
REDIS_PORT=6380
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6380

# --- Object storage: SeaweedFS (S3-compatible, replaces MinIO — see D29) ---
S3_PORT=8333
S3_ADMIN_PORT=23646
S3_ADMIN_USER=admin
S3_ADMIN_PASSWORD=change-me
S3_ACCESS_KEY_ID=heartlink
S3_SECRET_ACCESS_KEY=change-me-min-8-chars
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET_PHOTOS=photos

# --- API (NestJS) ---
API_PORT=4000
# Signs the session cookie. Generate one with:  openssl rand -base64 48
SESSION_SECRET=change-me-at-least-32-characters-long-secret
# Idle timeout in seconds (sliding). 604800 = 7 days.
SESSION_TTL_SECONDS=604800
# Absolute timeout in seconds, counted from login (D44). 2592000 = 30 days.
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# Local development runs over plain http, so Secure cookies must be off here. Keep true in production.
COOKIE_SECURE=false
# Account lockout (D41): 5 failures -> locked for 900 seconds.
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# --- AI service (FastAPI) ---
AI_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
