# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real secrets (this is a public repo).

# --- PostgreSQL (PostGIS + pgvector) ---
POSTGRES_USER=heartlink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=heartlink
POSTGRES_PORT=5432
DATABASE_URL=postgresql://heartlink:change-me@localhost:5432/heartlink

# --- Redis (BullMQ) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=heartlink
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_PHOTOS=photos

# --- API (NestJS) ---
API_PORT=4000
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32

# --- AI service (FastAPI) ---
AI_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
